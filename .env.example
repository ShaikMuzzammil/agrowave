# ─── Resend email delivery ─────────────────────────────────────────────────────
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The inbox address that receives contact-form and price-alert emails
# (matches TEAM_EMAIL in your Vercel dashboard)
TEAM_EMAIL=you@yourdomain.com

# The "From" address Resend uses to send mail.
# Must be a verified domain on Resend — or use "onboarding@resend.dev" for testing.
# (matches RESEND_FROM in your Vercel dashboard)
RESEND_FROM=AgroWave <hello@yourdomain.com>
