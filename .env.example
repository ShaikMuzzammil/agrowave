# ───────────────────────────────────────────────────────
# AgroWave Environment Variables
# Copy this file to .env.local and fill in your values
# ───────────────────────────────────────────────────────

# REQUIRED: Resend API Key — get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED: The email address where contact form messages will be delivered
# This can be any email you own (Gmail, custom domain, etc.)
HOST_EMAIL=your@email.com
