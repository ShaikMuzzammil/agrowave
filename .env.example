# ─── Resend email delivery ─────────────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys (free tier works fine)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The inbox address that receives contact-form and price-alert emails.
# This is YOUR email — wherever you want to receive messages.
TEAM_EMAIL=you@gmail.com

# ─── RESEND_FROM is NOT required ──────────────────────────────────────────────
# The API always sends FROM onboarding@resend.dev (Resend's pre-verified sender).
# This works on ALL Resend accounts — free or paid — without any domain setup.
# You can set this var but it will be ignored unless you have a verified domain.
# RESEND_FROM=AgroWave <hello@yourdomain.com>
