# ─────────────────────────────────────────────
#  AgroWave — Environment Variables
#  Copy this file to .env.local and fill values
# ─────────────────────────────────────────────

# Resend API Key — get one free at https://resend.com
# Required for real-time contact form emails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The email address where contact messages will be delivered TO you
# Must be a verified domain/email in your Resend account
HOST_EMAIL=your@email.com

# Optional: public URL of your deployment (used in email links)
NEXTAUTH_URL=https://your-domain.com

# Optional: OpenAI key for AI assistant
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
