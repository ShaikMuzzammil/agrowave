# ─────────────────────────────────────────────────────
# AgroWave – TerraForge AI  ·  Environment Variables
# ─────────────────────────────────────────────────────
# 1. Copy this file to .env.local
# 2. Fill in RESEND_API_KEY and HOST_EMAIL
# 3. NEVER commit .env.local to git

# Required — Contact form emails (Resend API)
# Get yours free at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The email address where contact messages will be delivered
HOST_EMAIL=your-actual-email@gmail.com

# Optional — Live weather data (OpenWeatherMap free tier)
# Get yours at: https://openweathermap.org/api
NEXT_PUBLIC_OPENWEATHERMAP_API_KEY=your_owm_key_here

# Optional — Set after first Vercel deploy
NEXT_PUBLIC_APP_URL=https://terra-project.vercel.app
